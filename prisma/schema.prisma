generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Provider { id String @id; name String; capabilities Json; priority Int; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; sources PlaybackSource[] }
model Title { id String @id; canonicalTitle String; originalTitle String?; description String?; year Int?; mediaType String; status String; popularityScore Float @default(0); rating Float?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; aliases TitleAlias[]; seasons Season[]; episodes Episode[]; sources PlaybackSource[]; @@index([canonicalTitle]); @@index([updatedAt]) }
model TitleAlias { id String @id @default(cuid()); titleId String; language String; type String; value String; normalizedValue String; title Title @relation(fields:[titleId],references:[id],onDelete: Cascade); @@index([normalizedValue]) }
model Season { id String @id; titleId String; seasonNumber Int; name String?; episodeCount Int?; title Title @relation(fields:[titleId],references:[id],onDelete: Cascade); episodes Episode[]; @@unique([titleId,seasonNumber]) }
model Episode { id String @id; titleId String; seasonId String?; episodeNumber Int?; absoluteNumber Int?; title String; mediaType String; titleRef Title @relation(fields:[titleId],references:[id],onDelete: Cascade); season Season? @relation(fields:[seasonId],references:[id],onDelete: SetNull); sources PlaybackSource[]; @@index([titleId]); }
model PlaybackSource { id String @id; providerId String; sourceId String; titleId String; episodeId String?; streamType String; format String; resolution String?; quality Int @default(0); audioLanguages String[]; subtitleLanguages String[]; region String?; licenseStatus String; availabilityStatus String; priority Int; healthScore Int @default(0); latency Int @default(0); expiresAt DateTime?; provider Provider @relation(fields:[providerId],references:[id]); title Title @relation(fields:[titleId],references:[id],onDelete: Cascade); episode Episode? @relation(fields:[episodeId],references:[id],onDelete: Cascade); @@unique([providerId,sourceId]); @@index([titleId,availabilityStatus]); }
model FieldProvenance { id String @id @default(cuid()); entity String; entityId String; field String; providerId String; valueHash String; confidence Float; updatedAt DateTime @updatedAt; @@index([entity,entityId]) }
