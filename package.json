{
  "name": "moviebox-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:status": "tsx scripts/migrate.ts status",
    "db:rollback": "tsx scripts/migrate.ts rollback",
    "db:seed": "tsx scripts/seed.ts",
    "reindex": "tsx scripts/reindex.ts",
    "health": "tsx scripts/health-check.ts",
    "production-check": "tsx scripts/production-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/rate-limit": "latest",
    "@opensearch-project/opensearch": "^3.6.0",
    "bullmq": "latest",
    "fastify": "latest",
    "fastify-plugin": "latest",
    "ioredis": "latest",
    "pg": "8.23.0",
    "pino": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
